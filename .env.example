# PowerShell: generate each local secret independently with:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLowerInvariant()
POSTGRES_PASSWORD=generate-a-local-value
OPERATOR_BASIC_USERNAME=operator
OPERATOR_BASIC_PASSWORD=generate-a-local-value
OPERATOR_SUBJECT=local-test-operator
OPERATOR_PROXY_SIGNING_SECRET=generate-at-least-32-random-characters
OPERATOR_AUTHORIZED_SUBJECTS=local-test-operator
OPERATOR_CREDENTIAL=generate-a-separate-local-value
FOOTBALL_DATA_API_TOKEN=provide-only-for-live-provider-smoke
# Privacy journey (the «Конфиденциальность» page and /internal-api/privacy/*):
# the web proxy and the API verify these HMAC signatures, and the retention
# policy stays «not final» until all four policy inputs are present. The trusted
# auth_session normally comes from your account system; the MVP ships none, so
# for a local demonstration set DEV_TRUSTED_SESSION_ISSUER=1 and open
# /internal/dev-session once — it redirects to /privacy with a ~30-day dev
# session for a fresh dev-local-subject-<random> identity each visit (a
# withdrawal permanently locks its subject by design, so re-visit to start
# clean). Without the flag the route is a 404.
AUTH_SESSION_SIGNING_SECRET=generate-at-least-32-random-characters
PRIVACY_SESSION_SIGNING_SECRET=generate-at-least-32-random-characters
PRIVACY_SUBJECT_SIGNING_SECRET=generate-a-separate-local-value
PRIVACY_SUBJECT_PROVIDER_MODE=signed
PRIVACY_RETENTION_DURATION_DAYS=30
PRIVACY_RETENTION_POLICY_VERSION=privacy-local-v1
PRIVACY_RETENTION_EFFECTIVE_AT=2026-10-01T00:00:00.000Z
DEV_TRUSTED_SESSION_ISSUER=
