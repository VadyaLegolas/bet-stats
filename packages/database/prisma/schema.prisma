generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReconciliationEntityType {
  LEAGUE
  SEASON
  TEAM
  PLAYER
  FIXTURE
}

enum ReconciliationCaseStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReconciliationCandidateStatus {
  SUGGESTED
  ACCEPTED
  REJECTED
}

enum ReconciliationAction {
  LINK
  CREATE
  QUARANTINE
  REJECT
}

enum ReconciliationMethod {
  EXACT_EXTERNAL_REF
  UNIQUE_CONSERVATIVE_MATCH
  MANUAL_REVIEW
  OPERATOR_CONFIRMED
}

model League {
  id           String              @id @default(cuid())
  name         String
  countryCode  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  seasons      Season[]
  fixtures     Fixture[]
  externalRefs LeagueExternalRef[]
  providerCapabilities ProviderCapability[]

  @@index([countryCode, name])
}

model Season {
  id           String              @id @default(cuid())
  leagueId     String
  label        String
  startsOn     DateTime            @db.Date
  endsOn       DateTime            @db.Date
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  league       League              @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  fixtures     Fixture[]
  externalRefs SeasonExternalRef[]
  providerCapabilities ProviderCapability[]

  @@unique([leagueId, label])
}

model ProviderCapability {
  id         String   @id @default(cuid())
  provider   String
  leagueId   String
  seasonId   String
  endpoint   String
  supported  Boolean
  verifiedAt DateTime
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@unique([provider, leagueId, seasonId, endpoint])
  @@index([provider, endpoint, verifiedAt])
}

model ProviderRequestReservation {
  id          String   @id @default(cuid())
  provider    String
  requestDate DateTime @db.Date
  endpoint    String
  jobKey      String
  reservedAt  DateTime @default(now())

  @@unique([provider, requestDate, endpoint, jobKey])
  @@index([provider, requestDate, endpoint])
}

model Team {
  id             String            @id @default(cuid())
  name           String
  normalizedName String
  countryCode    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  homeFixtures   Fixture[]         @relation("HomeTeamFixtures")
  awayFixtures   Fixture[]         @relation("AwayTeamFixtures")
  players        Player[]
  externalRefs   TeamExternalRef[]

  @@index([countryCode, normalizedName])
}

model Player {
  id             String              @id @default(cuid())
  currentTeamId  String?
  name           String
  normalizedName String
  countryCode    String?
  dateOfBirth    DateTime?           @db.Date
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  currentTeam    Team?               @relation(fields: [currentTeamId], references: [id], onDelete: SetNull)
  externalRefs   PlayerExternalRef[]

  @@index([normalizedName, countryCode])
}

model Fixture {
  id           String                  @id @default(cuid())
  leagueId     String
  seasonId     String
  homeTeamId   String
  awayTeamId   String
  kickoffUtc   DateTime
  status       String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  league       League                  @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  season       Season                  @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  homeTeam     Team                    @relation("HomeTeamFixtures", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam     Team                    @relation("AwayTeamFixtures", fields: [awayTeamId], references: [id], onDelete: Restrict)
  externalRefs FixtureExternalRef[]
  provenance   FixtureProvenance[]

  // D-10: deliberately non-unique; this index finds ±36h candidates only.
  @@index([homeTeamId, awayTeamId, kickoffUtc])
  @@index([leagueId, kickoffUtc])
}

model LeagueExternalRef {
  id         String   @id @default(cuid())
  leagueId   String
  provider   String
  externalId String
  createdAt  DateTime @default(now())
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([leagueId])
}

model SeasonExternalRef {
  id         String   @id @default(cuid())
  seasonId   String
  provider   String
  externalId String
  createdAt  DateTime @default(now())
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([seasonId])
}

model TeamExternalRef {
  id         String   @id @default(cuid())
  teamId     String
  provider   String
  externalId String
  createdAt  DateTime @default(now())
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([teamId])
}

model PlayerExternalRef {
  id         String   @id @default(cuid())
  playerId   String
  provider   String
  externalId String
  createdAt  DateTime @default(now())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([playerId])
}

model FixtureExternalRef {
  id         String   @id @default(cuid())
  fixtureId  String
  provider   String
  externalId String
  createdAt  DateTime @default(now())
  fixture    Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([fixtureId])
}

model FixtureProvenance {
  id             String   @id @default(cuid())
  fixtureId      String
  provider       String
  observedAt     DateTime @default(now())
  sourceUpdatedAt DateTime?
  payloadHash    String
  rawPayload     Json
  fixture        Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Restrict)

  @@unique([provider, payloadHash])
  @@index([fixtureId, observedAt])
}

model ReconciliationCase {
  id               String                      @id @default(cuid())
  entityType       ReconciliationEntityType
  provider         String
  externalId       String
  status           ReconciliationCaseStatus    @default(OPEN)
  version          Int                         @default(1)
  incomingSnapshot Json
  openedAt         DateTime                    @default(now())
  resolvedAt       DateTime?
  candidates       ReconciliationCandidate[]
  decisions        ReconciliationDecision[]

  @@index([status, entityType])
  @@index([provider, externalId])
}

model ReconciliationCandidate {
  id                  String                        @id @default(cuid())
  caseId              String
  canonicalEntityId   String
  status              ReconciliationCandidateStatus @default(SUGGESTED)
  method              ReconciliationMethod
  confidence          Decimal                       @db.Decimal(5, 4)
  evidence            Json
  createdAt           DateTime                      @default(now())
  reconciliationCase  ReconciliationCase            @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, canonicalEntityId])
  @@index([canonicalEntityId])
}

model ReconciliationDecision {
  id                    String                 @id @default(cuid())
  caseId                String
  action                ReconciliationAction
  method                ReconciliationMethod
  canonicalEntityId     String?
  evidence              Json
  confidence            Decimal                @db.Decimal(5, 4)
  actor                 String
  decidedAt             DateTime               @default(now())
  supersedesDecisionId  String?                @unique
  reconciliationCase    ReconciliationCase     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  supersedesDecision    ReconciliationDecision? @relation("DecisionSupersession", fields: [supersedesDecisionId], references: [id], onDelete: Restrict)
  supersededBy          ReconciliationDecision? @relation("DecisionSupersession")

  @@index([caseId, decidedAt])
  @@index([canonicalEntityId])
}
